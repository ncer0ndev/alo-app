{
  "name": "sesli-sohbet-app",
  "version": "1.3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release:draft": "electron-builder --win --x64 --publish always",
    "test:updater": "node --test test/updater.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aloapp.seslisohbet",
    "productName": "ALO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!test{,/**/*}",
      "!.npm-cache{,/**/*}"
    ],
    "publish": {
      "provider": "github",
      "owner": "ncer0ndev",
      "repo": "alo-app",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALO"
    }
  }
}
