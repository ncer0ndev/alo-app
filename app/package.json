{
  "name": "sesli-sohbet-app",
  "version": "1.10.5",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "release:mac": "electron-builder --mac --universal --publish always",
    "test:updater": "node --test test/updater.test.js",
    "test:ui": "node test/ui-preview.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aloapp.seslisohbet",
    "productName": "ALO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!test{,/**/*}",
      "!.npm-cache{,/**/*}"
    ],
    "publish": {
      "provider": "github",
      "owner": "ncer0ndev",
      "repo": "alo-app",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.social-networking",
      "identity": null,
      "minimumSystemVersion": "11.0",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ALO, sesli görüşmelere katılabilmen için mikrofon erişimine ihtiyaç duyar."
      }
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALO"
    }
  }
}
