# Zorunlu: uzun, rastgele bir deger. Ornek uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opsiyonel: sunucunun dinleyecegi port (Render bunu otomatik saglar)
PORT=3000

# --- Veritabani kalicilagi ---
# Bos birakilirsa sunucu yerel bir SQLite dosyasinda (./data/app.db) calisir -
# gelistirme ve testler icin budur, hizli ve kuruluma ihtiyac duymaz. Ancak
# Render gibi platformlarda disk yeniden dagitimda sifirlanabilir; production
# icin DATABASE_URL'i bir PostgreSQL baglanti dizesiyle doldurun (Render'in
# kendi "PostgreSQL" eklentisi bunu otomatik saglar - Dashboard > Postgres
# instance > "Internal Database URL" degerini kopyalayip buraya yapistirin).
# Doluysa sunucu otomatik olarak PostgreSQL kullanir.
DATABASE_URL=

# Opsiyonel: hedef Postgres SSL istemiyorsa (ör. yerel/Docker Postgres) bunu
# "disable" yapin. Bos birakilirsa SSL kullanilir (Render'in yonetilen
# Postgres'i icin varsayilan ve dogru davranis budur).
PGSSLMODE=

# Opsiyonel: yerel SQLite dosya modunda ozel bir veritabani yolu
# (varsayilan: ./data/app.db). DATABASE_URL doluysa yoksayilir.
DB_PATH=

# --- Kullanicinin kendi profil resmi/banner yuklemesi ---
# Bos birakilirsa yukleme uc noktalari 503 doner, katalogdan secim (avatar/
# banner) etkilenmez. Ucretsiz bir Cloudinary hesabi (cloudinary.com,
# kredi karti istemez) acip Dashboard'daki "API Environment variable"
# kutusunda gosterilen degeri BIREBIR buraya yapistirin (SDK kendini
# otomatik yapilandirir):
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Eski Turso verisini PostgreSQL'e tasima (yalnizca bir kereye mahsus,
# elle calistirilan script icin) ---
# node scripts/migrate-turso-to-postgres.js
# Bu iki degisken yalnizca o script tarafindan, KAYNAK olarak okunur;
# sunucunun kendisi artik Turso'ya baglanmiyor.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opsiyonel: TURN sunucusu (STUN'un yetmedigi kisitli aglarda/simetrik NAT
# arkasindaki kullanicilarda gorusmenin hic baglanamamasini onler).
# Bos birakilirsa sadece ucretsiz STUN kullanilir.
#
# --- Yontem 1 (onerilen): Metered.ca ucretsiz hesap ---
# Metered.ca'da ucretsiz bir hesap acip "App name" (ornegin "alo") ve API
# anahtarini buraya yazarsan, sunucu her istekte Metered'in kendi API'sinden
# taze/gecerli TURN kimlik bilgileri ceker (saatlik onbelleklenir). Ikisi de
# doluysa asagidaki TURN_* degiskenleri yoksayilir.
METERED_APP_NAME=
METERED_API_KEY=
#
# --- Yontem 2: sabit TURN sunucusu (kendi coturn'un veya baska bir servis) ---
# METERED_* bos ise kullanilir. Birden fazla adres virgulle ayrilabilir
# (farkli port/protokol secenekleri, kisitlayici aglarda yedek olarak
# kullanilir):
# TURN_URL=turn:ornek-turn-sunucusu.com:80,turn:ornek-turn-sunucusu.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
