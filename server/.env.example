# Zorunlu: uzun, rastgele bir deger. Ornek uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opsiyonel: sunucunun dinleyecegi port (Render bunu otomatik saglar)
PORT=3000

# Opsiyonel: SQLite veritabani dosya yolu (varsayilan: ./data/app.db)
DB_PATH=

# Opsiyonel: TURN sunucusu (STUN'un yetmedigi kisitli aglarda gerekir).
# Bos birakilirsa sadece ucretsiz STUN kullanilir.
# Ornek saglayicilar: Twilio, Cloudflare Calls, kendi coturn sunucunuz.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
