# Zorunlu: uzun, rastgele bir deger. Ornek uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opsiyonel: sunucunun dinleyecegi port (Render bunu otomatik saglar)
PORT=3000

# --- Veritabani kalicilagi ---
# Ikisi de bos birakilirsa sunucu yerel bir dosyada (./data/app.db) calisir.
# Bu, gelistirme icin sorunsuzdur AMA Render gibi platformlarda disk
# yeniden dagitimda sifirlanabilir - kalicilik icin asagidaki TURSO_*
# degiskenlerini doldurun (ucretsiz katman yeterlidir, bkz. turso.tech).
# Ikisi de doluysa sunucu otomatik olarak uzak Turso veritabanini kullanir.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opsiyonel: yerel dosya modunda ozel bir veritabani yolu (varsayilan: ./data/app.db)
DB_PATH=

# Opsiyonel: TURN sunucusu (STUN'un yetmedigi kisitli aglarda/simetrik NAT
# arkasindaki kullanicilarda gorusmenin hic baglanamamasini onler).
# Bos birakilirsa sadece ucretsiz STUN kullanilir.
#
# Varsayilan olarak Open Relay Project'in ucretsiz, kayit gerektirmeyen genel
# TURN sunucusu onerilir (paylasimli/garantisiz, kucuk bir arkadas grubu icin
# yeterli - https://www.metered.ca/tools/openrelay/). Birden fazla adres
# virgulle ayrilabilir (farkli port/protokol secenekleri, kisitlayici aglarda
# yedek olarak kullanilir):
# TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject
#
# Daha guvenilir/garantili bir servis istersen (ucretsiz Metered.ca hesabiyla
# kendine ait kimlik bilgileri, veya kendi coturn sunucun) buraya onun
# degerlerini yaz.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
